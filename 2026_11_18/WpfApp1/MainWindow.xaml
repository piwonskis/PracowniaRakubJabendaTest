<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Background="Cornsilk"
        Title="Wzornik kolorów rgb" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Label Margin="40px" Width="700px" Height="100px" Background="White" x:Name="kolorBlok"></Label>

            <Label FontSize="15px" >Dobierz kolor suwakami i zapisz przyciskiem:</Label>
            <StackPanel Orientation="Horizontal">
                <Label>R</Label>
                <Slider Width="700px" x:Name="R_slider" IsSnapToTickEnabled="True" TickFrequency="1" Minimum="0" Maximum="255" ValueChanged="R_slider_ValueChanged"></Slider>
                <Label x:Name="R_number">0</Label>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label>G</Label>
                <Slider Width="700px" x:Name="G_slider" IsSnapToTickEnabled="True" TickFrequency="1" Minimum="0" Maximum="255" ValueChanged="G_slider_ValueChanged"></Slider>
                <Label x:Name="G_number">0</Label>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label>B</Label>
                <Slider Width="700px" x:Name="B_slider" Minimum="0" IsSnapToTickEnabled="True" TickFrequency="1" Maximum="255" ValueChanged="B_slider_ValueChanged"></Slider>
                <Label x:Name="B_number" >0</Label>
            </StackPanel>
            <Button Width="150px" Background="Peru" Click="Button_Click">Pobierz</Button>

            <Label x:Name="Kolor_blok_2" Width="150px" Height="30px" Margin="20px" Background="White"></Label>
        </StackPanel>
        
        
    </Grid>
</Window>
